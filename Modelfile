# Модель ATLAS на базе qwen3:8b.
# 8B заметно сильнее 4B в планировании, многошаговых рассуждениях и вызове инструментов.
# Влезает целиком в 8 ГБ VRAM (Q4), поэтому работает быстро.
# 12k контекста + flash-attention с q8_0 KV-кэшем (см. start.bat): модель и кэш
# помещаются в 8 ГБ VRAM с запасом под дисплей, работает быстро, без выгрузки в ОЗУ.
# Системный промпт ~2–3k + инструменты ~2k оставляют ~7k на историю и выводы.
FROM qwen3:8b

PARAMETER num_ctx 12288

# Рекомендованные Qwen параметры для режима рассуждения (thinking):
# слишком низкая температура/greedy деградируют качество и вызывают повторы.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER repeat_penalty 1.05
